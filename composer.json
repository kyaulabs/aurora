{
	"name": "kyaulabs/aurora",
	"description": "Aurora PHP Framework — Bootstrap layer for applications at KYAULabs",
	"type": "project",
	"require": {
		"php": ">=8.5"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3",
		"pestphp/pest": "^4",
		"pestphp/pest-plugin-arch": "^4",
		"pestphp/pest-plugin-browser": "^4"
	},
	"autoload-dev": {
		"classmap": ["tests/"]
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	}
}
